# ==============================================================================
# Orbit Environment Configuration
# ==============================================================================

PORT=3001

# 1. Upstash Redis (Cross-Device Cloud Sync)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 2. Gmail SMTP Delivery (Sends to ANY email address worldwide)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourgmail@gmail.com
# 16-character Google App Password (from https://myaccount.google.com/apppasswords)
SMTP_PASS=abcdefghijklmnop
SMTP_FROM=Orbit <yourgmail@gmail.com>
