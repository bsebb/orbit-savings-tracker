# ==============================================================================
# Orbit Environment Configuration
# ==============================================================================

PORT=3001

# 1. Upstash Redis (Cross-Device Cloud Sync)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 2. Brevo HTTPS API (Sends to ANY email worldwide over Port 443 — no firewall blocking)
# Free 300 emails/day from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=orbit.auth.team@gmail.com
BREVO_SENDER_NAME=Orbit

# 3. Optional: Resend API Key
# RESEND_API_KEY=
# FROM_EMAIL=Orbit <onboarding@resend.dev>

# 4. Optional: Raw SMTP (If hosting on VPS/server where port 465/587 is not blocked)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=yourgmail@gmail.com
# SMTP_PASS=abcdefghijklmnop
# SMTP_FROM=Orbit <yourgmail@gmail.com>
