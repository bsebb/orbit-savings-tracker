# Upstash Redis Credentials (https://console.upstash.com/ - Free Serverless Redis)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Email Delivery Option 1: Standard SMTP / Gmail App Password (Recommended - sends to ANY email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
FROM_EMAIL="Orbit Savings" <your-email@gmail.com>

# Email Delivery Option 2: Resend API (https://resend.com/ - 100 free emails/day)
# NOTE: onboarding@resend.dev only sends to your Resend account email!
# To send to any user email with Resend, you must verify a custom domain.
RESEND_API_KEY=re_your_resend_api_key_here
# FROM_EMAIL=Orbit <onboarding@resend.dev>

# Server Port (Render sets this automatically)
PORT=3001

